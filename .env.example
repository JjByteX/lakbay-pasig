# This project uses two mode-specific env files instead of a plain .env —
# see the "Local vs Hosted" section in README.md.
#
#   .env.demo.local    -> local Docker Supabase, demo data, used by `npm run dev:demo`
#   .env.hosted.local   -> real hosted Supabase project, used by `npm run dev:hosted`
#
# Both are gitignored (matched by the *.local rule). This file is just a
# reference for the shape each of them needs:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. CARTO basemap tiles (Discover map) render with an "API key
# required" watermark when unset, the map still works otherwise. Get a
# free key (no account, no approval wait) at carto.com/basemaps/apikey.
VITE_CARTO_API_KEY=

# Voice search (the mic button in the search bar). These are NOT VITE_
# variables and do not go in a .local file: they are server only, read by
# api/transcribe.js on Vercel. Add them in the Vercel dashboard, Project
# Settings, Environment Variables, then redeploy. The mic needs a deployed
# site (or `vercel dev`); plain `npm run dev` has no /api, so the mic shows
# "Voice search isn't available here."
#   GROQ_API_KEY=         required, free key at console.groq.com (no card)
#   GROQ_STT_MODEL=       optional, default whisper-large-v3
#   GROQ_STT_LANGUAGE=    optional, e.g. tl to force Tagalog; unset detects it

